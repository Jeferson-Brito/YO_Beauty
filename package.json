{
  "name": "yo-beauty",
  "private": true,
  "version": "0.1.0",
  "description": "Loja virtual Yo Beauty — makes, cosméticos e acessórios.",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c magenta,blue \"npm run dev -w server\" \"npm run dev -w client\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "build": "npm run build --workspaces --if-present",
    "start": "npm run start -w server",
    "test": "npm run test -w server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:setup": "npm run db:setup -w server",
    "db:migrate": "npm run db:migrate -w server",
    "db:seed": "npm run db:seed -w server",
    "db:reset": "npm run db:reset -w server",
    "admin:create": "npm run admin:create -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
