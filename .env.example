# Copie este arquivo para server/.env
# No PowerShell: Copy-Item .env.example server\.env

NODE_ENV=development
PORT=3333

# Local: caminho relativo à pasta server/prisma.
# Produção (Supabase): use a connection string PostgreSQL com sslmode=require.
# Não publique o arquivo SQLite.
DATABASE_URL="file:./dev.db"

# Só o ambiente de teste usa SEED_DEMO=true. Sem essa variável, o seed cria a loja sem produtos fictícios.

CLIENT_ORIGIN=http://localhost:5173
STORE_TIMEZONE=America/Recife
SESSION_DAYS=7

# Troque os dois segredos antes de qualquer ambiente compartilhado.
# Em produção o servidor recusa valores que contenham "troque".
SESSION_SECRET=troque-este-segredo-de-sessao-com-bastante-entropia
ANALYTICS_HASH_SECRET=troque-este-segredo-de-analytics-com-bastante-entropia

# Usados apenas por npm run admin:create. Não crie o administrador pelo seed.
# A senha precisa ter pelo menos 10 caracteres, com letra e número.
# Se a senha tiver #, coloque o valor entre aspas.
ADMIN_NAME=Proprietaria
ADMIN_EMAIL=admin@yobeauty.local
ADMIN_PASSWORD=""
# ADMIN_RESET_PASSWORD=true

# Identificador do cliente OAuth do Google (Google Cloud → Credenciais → ID do cliente da Web).
# O mesmo valor aparece no botão "Continuar com Google". Sem ele, o botão avisa que falta configurar.
GOOGLE_CLIENT_ID=
